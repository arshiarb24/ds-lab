      "source": [
        "<a href=\"https://colab.research.google.com/github/arshiarb24/ds-lab/blob/main/tree%20traversal.bfs\" target=\"_parent\"><img src=\"https://colab.research.google.com/assets/colab-badge.svg\" alt=\"Open In Colab\"/></a>"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "from collections import defaultdict\n",
        "\n",
        "class Graph:\n",
        "    def __init__(self):\n",
        "        self.graph = defaultdict(list)\n",
        "\n",
        "    def addEdge(self, u, v):\n",
        "        self.graph[u].append(v)\n",
        "\n",
        "    def BFS(self, s):\n",
        "        # To handle cases where graph might have isolated nodes or non-contiguous indices\n",
        "        all_nodes = set(self.graph.keys()) | set(val for sublist in self.graph.values() for val in sublist)\n",
        "        # If the graph is empty, or only has nodes not connected to 's', num_nodes could be 0 or small.\n",
        "        # A more robust solution for 'visited' would use a set or map for sparse graphs.\n",
        "        # For this problem's context (small, 0-indexed, contiguous graph), we'll assume max node + 1 size is sufficient.\n",
        "        num_nodes = max(all_nodes) + 1 if all_nodes else 0\n",
        "\n",
        "        visited = [False] * num_nodes\n",
        "        queue = []\n",
        "\n",
        "        queue.append(s)\n",
        "        visited[s] = True\n",
        "\n",
        "        while queue:\n",
        "            s = queue.pop(0)\n",
        "            print(s, end=\" \")\n",
        "\n",
        "            for i in self.graph[s]:\n",
        "                if not visited[i]:\n",
        "                    queue.append(i)\n",
        "                    visited[i] = True\n",
        "\n",
        "# Driver code\n",
        "g = Graph()\n",
        "g.addEdge(0, 1)\n",
        "g.addEdge(0, 2)\n",
        "g.addEdge(1, 2)\n",
        "g.addEdge(2, 0)\n",
        "g.addEdge(2, 3)\n",
        "g.addEdge(3, 3)\n",
        "\n",
        "print(\"Following is Breadth First Traversal\" \" (starting from vertex 2)\")\n",
        "g.BFS(2)"
      ],
      "metadata": {
