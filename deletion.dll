      "source": [
        "<a href=\"https://colab.research.google.com/github/arshiarb24/ds-lab/blob/main/deletion.dll\" target=\"_parent\"><img src=\"https://colab.research.google.com/assets/colab-badge.svg\" alt=\"Open In Colab\"/></a>"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "class Node:\n",
        "    def __init__(self, data):\n",
        "        self.data = data\n",
        "        self.previous = None\n",
        "        self.next = None\n",
        "\n",
        "class DeleteStart:\n",
        "    def __init__(self):\n",
        "        self.head = None\n",
        "        self.tail = None\n",
        "\n",
        "    def addNode(self, data):\n",
        "        newNode = Node(data)\n",
        "        if self.head is None:\n",
        "            self.head = newNode\n",
        "            self.tail = newNode\n",
        "            # For a single node, previous and next are None, which is default\n",
        "        else:\n",
        "            self.tail.next = newNode\n",
        "            newNode.previous = self.tail\n",
        "            self.tail = newNode\n",
        "            self.tail.next = None # This was already in the original, ensuring tail.next is None for non-circular list\n",
        "\n",
        "    def deleteFromStart(self):\n",
        "        if self.head is None:\n",
        "            return # List is empty, nothing to delete\n",
        "        elif self.head == self.tail: # Only one element in the list\n",
        "            self.head = None\n",
        "            self.tail = None\n",
        "        else:\n",
        "            self.head = self.head.next\n",
        "            if self.head: # Ensure head is not None after moving\n",
        "                self.head.previous = None\n",
        "\n",
        "    def display(self):\n",
        "        current = self.head\n",
        "        if current is None:\n",
        "            print(\"List is empty\")\n",
        "            return\n",
        "        while current is not None:\n",
        "            print(current.data)\n",
        "            current = current.next\n",
        "        print()\n",
        "\n",
        "dList = DeleteStart()\n",
        "dList.addNode(1)\n",
        "dList.addNode(2)\n",
        "dList.addNode(3)\n",
        "dList.addNode(4)\n",
        "dList.addNode(5)\n",
        "\n",
        "print(\"Original List: \")\n",
        "dList.display()\n",
        "\n",
        "print(\"Deleting elements from start one by one:\")\n",
        "while dList.head is not None:\n",
        "    dList.deleteFromStart()\n",
        "    print(\"Updated List: \")\n",
        "    dList.display()\n"
      ],
