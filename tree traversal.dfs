        "<a href=\"https://colab.research.google.com/github/arshiarb24/ds-lab/blob/main/tree%20traversal.dfs\" target=\"_parent\"><img src=\"https://colab.research.google.com/assets/colab-badge.svg\" alt=\"Open In Colab\"/></a>"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "from collections import defaultdict\n",
        "\n",
        "class Graph:\n",
        "    def __init__(self):\n",
        "        self.graph = defaultdict(list)\n",
        "\n",
        "    def addEdge(self, u, v):\n",
        "        self.graph[u].append(v)\n",
        "\n",
        "    def DFSUtil(self, v, visited):\n",
        "        visited[v] = True\n",
        "        print(v, end=' ')\n",
        "        for i in self.graph[v]:\n",
        "            if visited[i] == False:\n",
        "                self.DFSUtil(i, visited)\n",
        "\n",
        "    def DFS(self, v):\n",
        "        # Mark all the vertices as not visited\n",
        "        # (can't use len(self.graph) if some nodes are isolated,\n",
        "        # better to find max node index or use a set)\n",
        "        # For this example, assuming nodes are 0-indexed and contiguous up to the max node in graph keys/values\n",
        "        all_nodes = set(self.graph.keys()) | set(val for sublist in self.graph.values() for val in sublist)\n",
        "        num_nodes = max(all_nodes) + 1 if all_nodes else 0\n",
        "        visited = [False] * num_nodes\n",
        "        self.DFSUtil(v, visited)\n",
        "\n",
        "# Driver code\n",
        "g = Graph()\n",
        "g.addEdge(0, 1)\n",
        "g.addEdge(0, 2)\n",
        "g.addEdge(1, 2)\n",
        "g.addEdge(2, 0)\n",
        "g.addEdge(2, 3)\n",
        "g.addEdge(3, 3)\n",
        "\n",
        "print(\"Following is DFS from (starting from vertex 2)\")\n",
        "g.DFS(2)"
      ],
