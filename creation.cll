      "source": [
        "<a href=\"https://colab.research.google.com/github/arshiarb24/ds-lab/blob/main/creation.cll\" target=\"_parent\"><img src=\"https://colab.research.google.com/assets/colab-badge.svg\" alt=\"Open In Colab\"/></a>"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "class Node:\n",
        "    def __init__(self, data):\n",
        "        self.data = data\n",
        "        self.next = None\n",
        "\n",
        "class CreateList:\n",
        "    def __init__(self):\n",
        "        self.head = None\n",
        "        self.tail = None\n",
        "\n",
        "    def add(self, data):\n",
        "        newNode = Node(data)\n",
        "        if self.head is None:\n",
        "            self.head = newNode\n",
        "            self.tail = newNode\n",
        "            self.head.next = self.head  # For a single node, it points to itself (circular)\n",
        "        else:\n",
        "            self.tail.next = newNode\n",
        "            self.tail = newNode\n",
        "            self.tail.next = self.head  # New node's next points to head to maintain circularity\n",
        "\n",
        "    def display(self):\n",
        "        if self.head is None:\n",
        "            print(\"List is empty\")\n",
        "            return\n",
        "\n",
        "        current = self.head\n",
        "        print(\"Nodes of the circular linked list:\")\n",
        "        while True:\n",
        "            print(current.data, end=\" \")\n",
        "            current = current.next\n",
        "            if current == self.head:\n",
        "                break\n",
        "        print()  # Add a newline at the end for better formatting\n",
        "\n",
        "# Driver code\n",
        "if __name__ == '__main__':\n",
        "    cl = CreateList()\n",
        "    cl.add(1)\n",
        "    cl.add(2)\n",
        "    cl.add(3)\n",
        "    cl.add(4)\n",
        "    cl.display()"
      ],
      "metadata": {
